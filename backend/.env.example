DB_HOST=localhost
DB_PORT=5432
DB_NAME=receipt_reconciliation
DB_USER=postgres
DB_PASSWORD=postgres
PORT=8080

# JWT signing key. There is no default: leave it unset and a random key is
# generated per process (all sessions end on restart). Must be set, unique and at
# least 32 characters when APP_ENV=production, or the service refuses to start.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Set to "production" to enforce the strict security posture: a real JWT_SECRET is
# required and the built-in demo account is not created.
APP_ENV=

# Set to false to require an ADMIN token for /auth/register. Defaults to true.
ALLOW_PUBLIC_REGISTRATION=true

# Overrides the password of the built-in development account (non-production only).
DEMO_USER_PASSWORD=

COMPANY_API_URL=https://api.company.example.com
COMPANY_API_KEY=your-company-api-key

# Directory uploaded receipts are written to and the OCR engine reads from.
# In Docker this is the mounted receipts volume.
RECEIPTS_DIR=receipts
# Path to the compiled C++ OCR engine binary. Auto-detected when unset.
OCR_ENGINE_PATH=
